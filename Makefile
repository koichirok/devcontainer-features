# Local task runner mirroring the GitHub Actions workflows
# (.github/workflows/test.yaml and release.yaml).

NAMESPACE    ?= koichirok/devcontainer-features
GITHUB_OWNER := $(firstword $(subst /, ,$(NAMESPACE)))
GITHUB_REPO  := $(lastword $(subst /, ,$(NAMESPACE)))

# All features under src/ by default; override like: make test FEATURES=github-cli
FEATURES    ?= $(notdir $(wildcard src/*))
# Base images used by the autogenerated tests (same as CI matrix)
BASE_IMAGES ?= debian:latest ubuntu:latest mcr.microsoft.com/devcontainers/base:ubuntu

.PHONY: help docs docs-check test test-autogenerated test-scenarios

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-20s %s\n", $$1, $$2}'

docs: ## Regenerate feature README.md files (same context as the CI docs-drift check)
	devcontainer features generate-docs \
		--project-folder ./src \
		--namespace $(NAMESPACE) \
		--github-owner $(GITHUB_OWNER) \
		--github-repo $(GITHUB_REPO)

docs-check: docs ## Regenerate docs and fail if committed READMEs drift
	git diff --exit-code -- 'src/*/README.md'

test: test-autogenerated test-scenarios ## Run autogenerated and scenario tests for all features

test-autogenerated: ## Run autogenerated tests (override: FEATURES=..., BASE_IMAGES=...)
	@set -e; for feature in $(FEATURES); do \
		for image in $(BASE_IMAGES); do \
			devcontainer features test --skip-scenarios -f $$feature -i $$image . ; \
		done; \
	done

test-scenarios: ## Run scenario tests (override: FEATURES=...)
	@set -e; for feature in $(FEATURES); do \
		devcontainer features test --skip-autogenerated --skip-duplicated -f $$feature . ; \
	done
